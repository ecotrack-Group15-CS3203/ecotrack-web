NEXT_PUBLIC_API_URL=http://localhost:3000

# Dev-only: set to "true" to skip real login and view the dashboard with a
# fake org_admin session (no backend required). Never enable in production.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Dev-only: set to "true" to serve dummy data for the "dev-org" organisation
# from lib/mock-data.ts instead of calling the real backend. Never enable in
# production.
NEXT_PUBLIC_USE_MOCK_API=false
