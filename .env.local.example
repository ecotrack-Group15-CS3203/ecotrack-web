# Server-side only: the target the same-origin BFF proxy (/api/proxy) forwards
# calls to. NOT 3001 -- ecotrack-api listens on 4000 with a global 'v1' prefix.
# On the EC2 host both containers run side by side, so production can use
# http://127.0.0.1:4000/v1 (or the API's public https URL).
API_URL=http://localhost:4000/v1

# Asgardeo -- NO NEXT_PUBLIC_ prefix on any of these. NEXT_PUBLIC_ vars are
# inlined into the browser bundle at build time; the client secret must never
# reach the browser.
#
# Production: both URIs use the real domain, and must match the web application's
# Authorized redirect URLs in the Asgardeo console exactly, e.g.
#   ASGARDEO_REDIRECT_URI=https://ecotrack.example.com/api/auth/callback
#   ASGARDEO_POST_LOGOUT_REDIRECT_URI=https://ecotrack.example.com
# Session cookies are marked Secure when NODE_ENV=production, so production must be
# served over HTTPS.
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
ASGARDEO_CLIENT_ID=<from the web app's Protocol tab>
ASGARDEO_CLIENT_SECRET=<from the web app's Protocol tab>
ASGARDEO_REDIRECT_URI=http://localhost:3000/api/auth/callback
ASGARDEO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Public Mapbox token used by components/incident-map.tsx. Build-time value (see
# Dockerfile). For production, restrict the token to the dashboard's URL in the
# Mapbox account settings, since anyone can read it from the bundle.
NEXT_PUBLIC_MAPBOX_TOKEN=<mapbox public token>

# Optional: download link for the mobile app (APK sideload or Expo build),
# shown on app/app/page.tsx. Leave unset to show a "coming soon" notice
# instead of a dead link. Build-time value.
NEXT_PUBLIC_MOBILE_APP_URL=
